# Copy to .env for local development. Production values live in Railway variables.
# Every setting has a default or is optional; the app boots with this file empty.

# DEBUG=true
# BASE_URL=http://localhost:8000

# Contact form. Shown once both Turnstile keys are set and mail can be sent:
# RESEND_API_KEY, or DEBUG=true to log messages instead. The from-address domain
# must be verified in Resend. These Turnstile test keys always pass locally.
# RESEND_API_KEY=re_...
# CONTACT_FROM_EMAIL=Portfolio contact <contact@jameshlms.com>
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# /resume redirects here; until it's set, /resume goes to the About page.
# RESUME_URL=https://cdn.example.com/james-holmes-resume.pdf

# Not used by any registered route yet; needed once these features ship.
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio   # blog/projects content, alembic
# REDIS_URL=redis://localhost:6379
# SESSION_SECRET_KEY=                                                 # admin sessions
# GITHUB_TOKEN=
# GITHUB_CLIENT_ID=                                                   # admin GitHub OAuth
# GITHUB_CLIENT_SECRET=
# GITHUB_ADMIN_USERNAME=
