<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- autoescape true %}
{%- for e in entries %}
  <url>
    <loc>{{ e.loc }}</loc>
    {%- if e.lastmod %}
    <lastmod>{{ e.lastmod.date().isoformat() }}</lastmod>
    {%- endif %}
    {%- for img in e.images %}
    <image:image>
      <image:loc>{{ img }}</image:loc>
    </image:image>
    {%- endfor %}
  </url>
{%- endfor %}
{%- endautoescape %}
</urlset>